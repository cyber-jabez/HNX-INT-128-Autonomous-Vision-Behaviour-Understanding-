# ==============================================================================
# HNX26PSI07 Autonomous Vision & Behaviour Understanding System
# Environment Configuration
# ==============================================================================

# Application & Server
APP_NAME="HNX26PSI07 Autonomous Vision & Behaviour Understanding System"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database (Modular: SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./hnx_vision.db

# Object Detection (Ultralytics YOLO)
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.35
PROCESSING_FPS=10.0
DEVICE=auto

# Temporal Kinematics & Behaviour Thresholds
STATIONARY_THRESHOLD=15.0
RUNNING_SPEED_THRESHOLD=80.0
LOITERING_THRESHOLD=5.0

# Natural Language Explanation (LLM)
LLM_PROVIDER=none
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage Directories
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
EVIDENCE_DIR=./evidence

# Logging
LOG_LEVEL=INFO
